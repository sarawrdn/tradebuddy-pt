// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Shariah Stock Universe (PRD 7 - Shariah Stock Universe)
// ---------------------------------------------------------------------------

enum ShariahStatus {
  COMPLIANT
  NON_COMPLIANT
  UNDER_REVIEW
}

model ShariahStock {
  id            String        @id @default(cuid())
  symbol        String        @unique
  company       String
  sector        String
  industry      String
  marketCap     Decimal       @db.Decimal(20, 2)
  shariahStatus ShariahStatus @default(UNDER_REVIEW)
  lastUpdated   DateTime      @updatedAt
  createdAt     DateTime      @default(now())

  // Most recent backtest of the deterministic Data Signal against this
  // stock's own history — used to gate live BUY signals so we stop trading
  // setups that already proved to be net losers (see lib/backtest).
  backtestAvgReturnPct Decimal?  @db.Decimal(10, 4)
  backtestWinRate      Decimal?  @db.Decimal(6, 2)
  backtestSignals      Int?
  backtestUpdatedAt    DateTime?

  watchlistItems  WatchlistItem[]
  holdings        Holding[]
  trades          Trade[]
  recommendations AIRecommendation[]
  paperTrades     PaperTrade[]
  priceHistory    PriceHistory[]

  @@index([shariahStatus])
  @@index([sector])
}

// ---------------------------------------------------------------------------
// Price History — daily OHLCV cache from Twelve Data, used to compute real
// technical indicators (RSI, EMA, trend) instead of reasoning from a single
// live quote. Fetched once per day per stock and cached here to stay well
// under Twelve Data's free-tier rate limit.
// ---------------------------------------------------------------------------

model PriceHistory {
  id      String       @id @default(cuid())
  stockId String
  stock   ShariahStock @relation(fields: [stockId], references: [id])
  date    DateTime     @db.Date
  open    Decimal      @db.Decimal(20, 6)
  high    Decimal      @db.Decimal(20, 6)
  low     Decimal      @db.Decimal(20, 6)
  close   Decimal      @db.Decimal(20, 6)
  volume  BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stockId, date])
  @@index([stockId])
}

// ---------------------------------------------------------------------------
// Watchlist (PRD 8 - Dashboard > Watchlist)
// ---------------------------------------------------------------------------

model WatchlistItem {
  id               String       @id @default(cuid())
  stockId          String
  stock            ShariahStock @relation(fields: [stockId], references: [id])
  aiScore          Decimal?     @db.Decimal(5, 2)
  technicalScore   Decimal?     @db.Decimal(5, 2)
  fundamentalScore Decimal?     @db.Decimal(5, 2)
  sentimentScore   Decimal?     @db.Decimal(5, 2)
  addedAt          DateTime     @default(now())
  notes            String?

  @@unique([stockId])
}

// ---------------------------------------------------------------------------
// Portfolio Manager (PRD 7 - Portfolio Manager)
// ---------------------------------------------------------------------------

model Portfolio {
  id          String   @id @default(cuid())
  name        String   @default("Main Portfolio")
  cashBalance Decimal  @default(0) @db.Decimal(20, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  holdings  Holding[]
  trades    Trade[]
  snapshots PortfolioSnapshot[]
}

model Holding {
  id           String       @id @default(cuid())
  portfolioId  String
  portfolio    Portfolio    @relation(fields: [portfolioId], references: [id])
  stockId      String
  stock        ShariahStock @relation(fields: [stockId], references: [id])
  quantity     Decimal      @db.Decimal(20, 6)
  averageCost  Decimal      @db.Decimal(20, 6)
  currentPrice Decimal?     @db.Decimal(20, 6)
  updatedAt    DateTime     @updatedAt
  createdAt    DateTime     @default(now())

  @@unique([portfolioId, stockId])
}

// ---------------------------------------------------------------------------
// Portfolio Snapshot Engine (PRD 7 - Portfolio Snapshot Engine)
// ---------------------------------------------------------------------------

model PortfolioSnapshot {
  id               String    @id @default(cuid())
  portfolioId      String
  portfolio        Portfolio @relation(fields: [portfolioId], references: [id])
  snapshotDate     DateTime  @db.Date
  cashBalance      Decimal   @db.Decimal(20, 2)
  portfolioValue   Decimal   @db.Decimal(20, 2)
  unrealizedProfit Decimal   @db.Decimal(20, 2)
  realizedProfit   Decimal   @db.Decimal(20, 2)
  dailyProfit      Decimal   @db.Decimal(20, 2)
  dailyReturnPct   Decimal   @db.Decimal(9, 4)
  totalReturnPct   Decimal   @db.Decimal(9, 4)
  openPositions    Int
  largestWinner    String?
  largestLoser     String?
  createdAt        DateTime  @default(now())

  @@unique([portfolioId, snapshotDate])
  @@index([snapshotDate])
}

// ---------------------------------------------------------------------------
// Trade Journal (PRD 7 - Trade Journal)
// ---------------------------------------------------------------------------

enum ExitReason {
  TAKE_PROFIT
  STOP_LOSS
  AI_SELL_SIGNAL
  MANUAL
  OTHER
}

model Trade {
  id               String          @id @default(cuid())
  portfolioId      String
  portfolio        Portfolio       @relation(fields: [portfolioId], references: [id])
  stockId          String
  stock            ShariahStock    @relation(fields: [stockId], references: [id])
  buyDate          DateTime
  sellDate         DateTime?
  quantity         Decimal         @db.Decimal(20, 6)
  buyPrice         Decimal         @db.Decimal(20, 6)
  sellPrice        Decimal?        @db.Decimal(20, 6)
  fees             Decimal         @default(0) @db.Decimal(20, 2)
  realizedProfit   Decimal?        @db.Decimal(20, 2)
  holdingDays      Int?
  aiConfidence     Decimal?        @db.Decimal(5, 2)
  aiRecommendation Recommendation?
  investmentThesis String?
  exitReason       ExitReason?
  personalNotes    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([stockId])
  @@index([portfolioId])
}

// ---------------------------------------------------------------------------
// AI Recommendation History (PRD 7 - AI Recommendation History, PRD 6 - Decision Agent)
// ---------------------------------------------------------------------------

enum Recommendation {
  BUY
  HOLD
  SELL
  WATCH
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum UserDecision {
  FOLLOWED
  IGNORED
  PARTIAL
  PENDING
}

model AIRecommendation {
  id                  String         @id @default(cuid())
  stockId             String
  stock               ShariahStock   @relation(fields: [stockId], references: [id])
  date                DateTime       @default(now())
  tradingStyle        TradingStyle   @default(INTRADAY)
  recommendation      Recommendation
  confidence          Decimal        @db.Decimal(5, 2)
  entryPrice          Decimal?       @db.Decimal(20, 6)
  stopLoss            Decimal?       @db.Decimal(20, 6)
  takeProfit          Decimal?       @db.Decimal(20, 6)
  // How entryPrice/stopLoss/takeProfit above were calculated — always
  // code-derived from support/resistance/ATR, never AI discretion. See
  // lib/indicators/calculateTradeLevels.
  priceLevelReasoning Json?
  holdingPeriod       String?
  investmentThesis    String
  riskLevel           RiskLevel
  supportingReasons   Json

  technicalScore   Decimal? @db.Decimal(5, 2)
  fundamentalScore Decimal? @db.Decimal(5, 2)
  sentimentScore   Decimal? @db.Decimal(5, 2)

  // Deterministic rule-based signal (RSI/SMA/trend, no AI) — a sanity-check
  // baseline alongside `recommendation` above, which comes from DeepSeek.
  technicalSignal        Recommendation?
  technicalReasoning     Json?
  technicalHoldingPeriod String?

  // AI-estimated probability/return/drawdown from the expanded indicator
  // set (EMA10-200, Bollinger, Stochastic RSI, OBV, VWAP, ROC) — an LLM
  // estimate, not a statistically fitted model. See DecisionOutput.
  probabilityOfProfit Decimal? @db.Decimal(5, 2)
  expectedReturnPct   Decimal? @db.Decimal(6, 2)
  expectedDrawdownPct Decimal? @db.Decimal(6, 2)

  userDecision      UserDecision @default(PENDING)
  resultAfter1Day   Decimal?     @db.Decimal(9, 4)
  resultAfter7Days  Decimal?     @db.Decimal(9, 4)
  resultAfter30Days Decimal?     @db.Decimal(9, 4)

  createdAt DateTime @default(now())

  paperTrades PaperTrade[]

  @@index([stockId])
  @@index([date])
  @@index([recommendation])
}

// ---------------------------------------------------------------------------
// App Settings — single-row config for this personal, single-user app.
// ---------------------------------------------------------------------------

enum TradingStyle {
  INTRADAY
  SWING
}

model AppSettings {
  id           String       @id @default(cuid())
  tradingStyle TradingStyle @default(INTRADAY)
  cashBalance  Decimal      @default(0) @db.Decimal(20, 2)
  updatedAt    DateTime     @updatedAt
}

// ---------------------------------------------------------------------------
// Trade Plan Optimization
//
// A grid search over stop-loss/take-profit % combinations, backtested against
// pooled historical signals within a volatility bucket (stocks grouped by
// ATR%, not optimized individually — too few signals per stock to avoid
// curve-fitting to one stock's specific history). The winning combination per
// bucket becomes the deterministic price-level source for stocks in that
// bucket, in place of the fixed support/resistance/ATR rule in
// calculateTradeLevels. See lib/optimize.
// ---------------------------------------------------------------------------

enum VolatilityBucket {
  LOW
  MEDIUM
  HIGH
}

model OptimizedTradePlan {
  id               String           @id @default(cuid())
  volatilityBucket VolatilityBucket
  tradingStyle     TradingStyle     @default(SWING)
  stopPct          Decimal          @db.Decimal(6, 4)
  targetPct        Decimal          @db.Decimal(6, 4)
  winRate          Decimal?         @db.Decimal(6, 2)
  avgReturnPct     Decimal?         @db.Decimal(6, 2)
  avgHoldingDays   Decimal?         @db.Decimal(6, 2)
  signalCount      Int
  filledCount      Int
  // Highest current ATR% among stocks placed in this bucket at the last
  // optimizer run — used to classify a stock into LOW/MEDIUM/HIGH going
  // forward without re-deriving live terciles on every request. See
  // lib/optimize/getVolatilityBucket.
  atrPctMax        Decimal?         @db.Decimal(6, 2)
  // Out-of-sample: this plan's performance on the held-out TEST portion of
  // history — days never used to select it. The train fields above (winRate,
  // avgReturnPct) will always look at least as good as this; trust this one.
  oosWinRate       Decimal?         @db.Decimal(6, 2)
  oosAvgReturnPct  Decimal?         @db.Decimal(6, 2)
  oosFilledCount   Int?
  updatedAt        DateTime         @updatedAt

  @@unique([volatilityBucket, tradingStyle])
}

// ---------------------------------------------------------------------------
// Paper Trading (PRD 11 - Roadmap Phase 3: Paper trading, AI performance scoring)
//
// Simulated trades derived from an approved AI recommendation. No real money
// or broker involved: an order sits PENDING until the live price reaches the
// recommended entry, then OPEN until it reaches stop loss or take profit.
// ---------------------------------------------------------------------------

enum PaperTradeStatus {
  PENDING
  OPEN
  CLOSED_WIN
  CLOSED_LOSS
  CLOSED_MANUAL
  CANCELLED
}

model PaperTrade {
  id String @id @default(cuid())

  stockId          String
  stock            ShariahStock      @relation(fields: [stockId], references: [id])
  recommendationId String?
  recommendation   AIRecommendation? @relation(fields: [recommendationId], references: [id])

  quantity   Decimal  @db.Decimal(20, 6)
  entryPrice Decimal  @db.Decimal(20, 6)
  stopLoss   Decimal? @db.Decimal(20, 6)
  takeProfit Decimal? @db.Decimal(20, 6)

  status PaperTradeStatus @default(PENDING)

  approvedAt       DateTime  @default(now())
  filledEntryAt    DateTime?
  filledEntryPrice Decimal?  @db.Decimal(20, 6)
  filledExitAt     DateTime?
  filledExitPrice  Decimal?  @db.Decimal(20, 6)
  exitReason       String?
  realizedProfit   Decimal?  @db.Decimal(20, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([stockId])
}

// ---------------------------------------------------------------------------
// Daily Market Report (PRD 7 - Daily Market Research)
// ---------------------------------------------------------------------------

model DailyMarketReport {
  id                String   @id @default(cuid())
  reportDate        DateTime @unique @db.Date
  marketSummary     String
  bullishPoints     Json
  bearishPoints     Json
  indices           Json?
  sectorPerformance Json?
  economicCalendar  Json?
  earningsCalendar  Json?
  createdAt         DateTime @default(now())
}
