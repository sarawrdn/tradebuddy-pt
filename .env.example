# Supabase Postgres connection string (used by Prisma)
# Get this from Supabase project settings > Database > Connection string (URI, "Transaction" pooler for serverless)
DATABASE_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres"

# Supabase project keys (needed if using the Supabase JS client alongside Prisma)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# AI (DeepSeek — OpenAI-compatible API, https://platform.deepseek.com)
DEEPSEEK_API_KEY=""

# Market data (Finnhub — https://finnhub.io/register)
FINNHUB_API_KEY=""

# Historical daily OHLCV for technical indicators (Twelve Data — https://twelvedata.com)
TWELVE_DATA_API_KEY=""

# Telegram notifications
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Vercel Cron (secret used to authenticate cron-triggered API routes)
CRON_SECRET=""
